confirm() {
  read -r -p "$1 [Y/n]: " response
  case "$response" in
  [nN][oO] | [nN])
    false
    ;;
  *)
    true
    ;;
  esac
}

check_sudo() {
  if ! sudo -n true 2>/dev/null; then
    print_warning "Sudo access required. You may be prompted for password."
  fi
}

do_update() {
  print_header "System Update"
  if confirm "Update package database and upgrade system?"; then
    sudo pacman -Syu --needed
    print_success "System updated"
    read -r -p "Press Enter to continue..." || true
  else
    print_warning "Update skipped"
  fi
}

do_aur_update() {
  print_header "AUR Update (paru)"
  if ! command -v paru &>/dev/null; then
    print_warning "paru not found — skipping AUR update"
    read -r -p "Press Enter to continue..." || true
    return 0
  fi
  if confirm "Update AUR packages?"; then
    paru -Sua
    print_success "AUR packages updated"
    read -r -p "Press Enter to continue..." || true
  else
    print_warning "AUR update skipped"
  fi
}

do_orphans() {
  print_header "Orphan Packages"

  if ! orphans=$(pacman -Qtdq 2>/dev/null) || [ -z "$orphans" ]; then
    print_success "No orphan packages found"
    read -r -p "Press Enter to continue..." || true
    return 0
  fi

  echo "Found orphan packages:"
  echo "$orphans"

  if confirm "Remove these orphan packages?"; then
    echo "$orphans" | xargs -r sudo pacman -Rns --
    print_success "Orphans removed"
  else
    print_warning "Orphans kept"
  fi
  read -r -p "Press Enter to continue..." || true
}

# FIXED: Shows current cache status and actual paccache output
do_cache() {
  print_header "Package Cache Cleanup"

  if ! command -v paccache &>/dev/null; then
    print_warning "paccache not found (install: sudo pacman -S pacman-contrib)"
    if confirm "Use pacman -Sc instead? (keeps only latest version)"; then
      sudo pacman -Sc
      print_success "Cache cleaned"
    fi
    return 0
  fi

  # Show current cache size first
  echo "Current cache status:"
  echo "  Packages in cache: $(find /var/cache/pacman/pkg -maxdepth 1 -name '*.pkg.tar*' 2>/dev/null | wc -l)"
  echo "  Cache size: $(du -sh /var/cache/pacman/pkg/ 2>/dev/null | cut -f1)"
  echo ""

  echo "Cache cleanup options:"
  echo "  1) Keep 3 recent versions (recommended)"
  echo "  2) Keep 1 recent version (aggressive)"
  echo "  3) Remove uninstalled packages (keep 0)"
  echo "  4) Dry run (preview only)"
  echo "  5) Skip"

  read -r -p "Select option [1-5]: " choice || true

  case $choice in
  1)
    echo ""
    echo "Running: paccache -rv (keep 3 versions)..."
    sudo paccache -rv
    echo ""
    print_success "Cache cleanup completed"
    read -r -p "Press Enter to continue..." || true
    ;;
  2)
    if confirm "This keeps only 1 version. Continue?"; then
      echo ""
      echo "Running: paccache -rvk1 (keep 1 version)..."
      sudo paccache -rvk1
      echo ""
      print_success "Cache cleanup completed"
    else
      print_warning "Cache cleanup skipped"
    fi
    read -r -p "Press Enter to continue..." || true
    ;;
  3)
    if confirm "Remove ALL cached versions of uninstalled packages?"; then
      echo ""
      echo "Running: paccache -rvuk0 (remove uninstalled)..."
      sudo paccache -rvuk0
      echo ""
      print_success "Uninstalled packages removed from cache"
    else
      print_warning "Cache cleanup skipped"
    fi
    read -r -p "Press Enter to continue..." || true
    ;;
  4)
    echo ""
    echo "Dry run - packages that would be removed:"
    paccache -dv
    read -r -p "Press Enter to continue..." || true
    ;;
  *)
    print_warning "Cache cleanup skipped"
    read -r -p "Press Enter to continue..." || true
    ;;
  esac
}

do_db_check() {
  print_header "Database Check"
  if confirm "Check package database for errors?"; then
    echo "Checking database..."
    if pacman -Dk; then
      print_success "Database OK"
    else
      print_error "Database issues found (see above)"
    fi
    read -r -p "Press Enter to continue..." || true
  fi
}

_get_appimage_list() {
  local pkgsync_config="$HOME/.config/pkgsync/config"
  local list=""

  if [ -f "$pkgsync_config" ]; then
    local repo_dir
    repo_dir=$(bash -c "source '$pkgsync_config' 2>/dev/null && echo \"\$REPO_DIR\"")
    if [ -n "$repo_dir" ] && [ -f "$repo_dir/pkglist-appimage.txt" ]; then
      list=$(cat "$repo_dir/pkglist-appimage.txt")
    fi
  fi

  if [ -z "$list" ]; then
    list=$(find "$HOME" -maxdepth 4 -name "*.AppImage" 2>/dev/null | sort) || true
  fi

  echo "$list"
}

do_appimage_update() {
  print_header "AppImage Updates"

  if ! command -v appimageupdatetool &>/dev/null; then
    print_warning "appimageupdatetool is not installed"
    echo -e "  Use ${GREEN}n${NC} → Install AppImage Tool to install it first"
    read -r -p "Press Enter to continue..." || true
    return 0
  fi

  local appimage_list
  appimage_list=$(_get_appimage_list) || true

  if [ -z "$appimage_list" ]; then
    print_warning "No AppImages found"
    read -r -p "Press Enter to continue..." || true
    return 0
  fi

  local count
  count=$(echo "$appimage_list" | wc -l)
  echo "Found $count AppImage(s):"
  echo "$appimage_list" | while IFS= read -r f; do
    echo "  - $(basename "$f")"
  done
  echo ""

  if ! confirm "Update AppImages?"; then
    print_warning "AppImage update skipped"
    read -r -p "Press Enter to continue..." || true
    return 0
  fi

  local updated=0 skipped=0 failed=0

  while IFS= read -r appimage; do
    [ -z "$appimage" ] && continue
    local name output
    name=$(basename "$appimage")
    echo ""
    echo -e "  ${CYAN}→ ${name}${NC}"

    if ! [ -f "$appimage" ]; then
      print_warning "  Not found: $appimage"
      failed=$((failed + 1))
      continue
    fi

    output=$(appimageupdatetool "$appimage" 2>&1) && local rc=0 || local rc=$?
    if [ "$rc" -eq 0 ]; then
      if echo "$output" | grep -qi "already.*up.to.date\|no update\|is up to date"; then
        print_success "  Already up to date"
        skipped=$((skipped + 1))
      else
        print_success "  Updated successfully"
        updated=$((updated + 1))
      fi
    else
      if echo "$output" | grep -qi "no.*update.*information\|cannot.*find.*update\|update information.*not.*embed\|no appstream"; then
        print_warning "  No update info embedded — manual update needed:"
        echo -e "    ${CYAN}1)${NC} Download the new version from the app's website or GitHub releases"
        echo -e "    ${CYAN}2)${NC} Replace: ${ITALIC}$appimage${NC}"
        echo -e "    ${CYAN}3)${NC} Run: ${ITALIC}chmod +x $appimage${NC}"
        skipped=$((skipped + 1))
      else
        print_error "  Failed"
        echo "$output" | head -3 | while IFS= read -r line; do echo "    $line"; done
        failed=$((failed + 1))
      fi
    fi
  done <<< "$appimage_list"

  echo ""
  echo -e "  ${GREEN}Updated: $updated${NC}  ${YELLOW}Skipped: $skipped${NC}  ${RED}Failed: $failed${NC}"
  read -r -p "Press Enter to continue..." || true
}

do_install_appimage_tool() {
  print_header "Install AppImage Update Tool"

  if command -v appimageupdatetool &>/dev/null; then
    print_success "appimageupdatetool is already installed"
    read -r -p "Press Enter to continue..." || true
    return 0
  fi

  if ! command -v paru &>/dev/null; then
    print_error "paru not found — cannot install"
    read -r -p "Press Enter to continue..." || true
    return 0
  fi

  if confirm "Install appimageupdate-git via paru?"; then
    paru -S appimageupdate-git || true
    echo ""
    if command -v appimageupdatetool &>/dev/null; then
      print_success "appimageupdatetool installed successfully"
    else
      print_error "Installation may have failed — check output above"
    fi
    read -r -p "Press Enter to continue..." || true
  else
    print_warning "Installation skipped"
    read -r -p "Press Enter to continue..." || true
  fi
}

do_foreign() {
  print_header "Foreign/AUR Packages"

  if ! foreign=$(pacman -Qm 2>/dev/null) || [ -z "$foreign" ]; then
    print_success "No foreign packages"
    read -r -p "Press Enter to continue..." || true
    return 0
  fi

  echo "Foreign packages installed:"
  echo "$foreign"
  count=$(echo "$foreign" | wc -l)
  print_warning "$count foreign packages found (review manually if needed)"
  read -r -p "Press Enter to continue..." || true
}

do_info() {
  local interactive=${1:-true}
  print_header "System Info"
  echo "Disk usage:"
  df -h / | tail -1

  echo -e "\nPackage statistics:"
  echo "  Explicitly installed: $(pacman -Qe | wc -l)"
  echo "  Total installed: $(pacman -Q | wc -l)"
  echo "  Orphans: $(pacman -Qtdq 2>/dev/null | wc -l)"
  echo "  Foreign: $(pacman -Qm 2>/dev/null | wc -l)"

  if command -v paccache &>/dev/null; then
    local cache_count
    cache_count=$(find /var/cache/pacman/pkg -maxdepth 1 -name '*.pkg.tar*' 2>/dev/null | wc -l)
    echo "  Cache packages: $cache_count"
  fi
  [[ "$interactive" == true ]] && read -r -p "Press Enter to continue..." || true
}

do_quick() {
  print_header "QUICK MODE"
  print_warning "Running: update, orphans, cache (keep 3), db check, info"

  sudo pacman -Syu --needed --noconfirm

  if command -v paru &>/dev/null; then
    paru -Sua --noconfirm
  fi

  if command -v appimageupdatetool &>/dev/null; then
    local ai_list
    ai_list=$(_get_appimage_list)
    if [ -n "$ai_list" ]; then
      while IFS= read -r appimage; do
        [ -f "$appimage" ] && appimageupdatetool "$appimage" &>/dev/null || true
      done <<< "$ai_list"
    fi
  fi

  if orphans=$(pacman -Qtdq 2>/dev/null) && [ -n "$orphans" ]; then
    echo "$orphans" | xargs -r sudo pacman -Rns --noconfirm --
  fi

  if command -v paccache &>/dev/null; then
    sudo paccache -r 2>/dev/null || true
  fi

  if ! pacman -Dk &>/dev/null; then
    print_warning "Database issues detected (run full check for details)"
  fi

  do_info false
}

# ─── Menu definition ─────────────────────────────────────────────────────────
_MENU_INITIALIZED=false
MENU_KEYS=("q" "u" "a" "p" "n" "o" "c" "d" "f" "i" "r" "0")
MENU_LABELS=(
  "QUICK MODE"
  "System Update"
  "AUR Update"
  "AppImage Update"
  "Install AppImage Update Tool"
  "Remove Orphans"
  "Clean Cache"
  "Check Database"
  "List Foreign/AUR"
  "System Info"
  "Run All (interactive)"
  "Exit"
)

_box_blank() {
  echo -e "    ${CYAN}${ITALIC}║${NC}                                              ${CYAN}${ITALIC}║${NC}"
}

_box_rule() {
  printf "    ${CYAN}${ITALIC}║${NC}  ${CYAN}────────────────────────────────────────────${NC}${CYAN}${ITALIC}║${NC}\n"
}

_menu_section() {
  local title="$1"
  local prefix="── ${title} "
  local fill=$(( 44 - ${#prefix} ))
  [[ $fill -lt 2 ]] && fill=2
  local dashes="" i
  for ((i=0; i<fill; i++)); do dashes="${dashes}─"; done
  printf "    ${CYAN}${ITALIC}║${NC}  ${CYAN}%s%s${NC}${CYAN}${ITALIC}║${NC}\n" "$prefix" "$dashes"
}

_menu_item() {
  local key="$1"
  local label="$2"
  local is_selected="$3"
  local pad=$(( 38 - ${#key} - ${#label} ))
  [[ $pad -lt 0 ]] && pad=0

  if [[ "$is_selected" == "true" ]]; then
    printf "    ${CYAN}${ITALIC}║${NC}  ${BRIGHT_PINK}> %s -> %s${NC}%*s${CYAN}${ITALIC}║${NC}\n" \
      "$key" "$label" "$pad" ""
  elif [[ "$key" == "0" ]]; then
    printf "    ${CYAN}${ITALIC}║${NC}  ${PINK}>${NC} ${RED}%s${NC} -> %s%*s${CYAN}${ITALIC}║${NC}\n" \
      "$key" "$label" "$pad" ""
  else
    printf "    ${CYAN}${ITALIC}║${NC}  ${PINK}>${NC} ${GREEN}%s${NC} -> %s%*s${CYAN}${ITALIC}║${NC}\n" \
      "$key" "$label" "$pad" ""
  fi
}

# ─── Main menu ────────────────────────────────────────────────────────────────
show_menu() {
  local selected="${1:-0}"

  local init_seq
  if [[ "$_MENU_INITIALIZED" == "false" ]]; then
    init_seq=$'\033[2J\033[H'
    _MENU_INITIALIZED=true
  else
    init_seq=$'\033[H'
  fi

  local buf
  buf=$(
    printf '%s' "$init_seq"
    printf '\033[?25l'
    print_banner

    echo -e "  ${CYAN}* ${CYAN}${ITALIC}╔══════════════════════════════════════════════╗${NC}${CYAN} *"
    echo -e "    ${CYAN}${ITALIC}║${NC} ${BRIGHT_PINK}* Arch Linux Maintenance Script *${NC}            ${CYAN}${ITALIC}║${NC}"
    echo -e "    ${CYAN}${ITALIC}╠══════════════════════════════════════════════╣${NC}"
    _box_blank

    local i
    for i in "${!MENU_KEYS[@]}"; do
      case $i in
        1) _box_blank; _menu_section "Updates"; _box_blank ;;
        5) _box_blank; _menu_section "Maintenance"; _box_blank ;;
        8) _box_blank; _menu_section "Info"; _box_blank ;;
        10) _box_blank; _menu_section "Advanced"; _box_blank ;;
        11) _box_blank; _box_rule ;;
      esac

      local is_sel="false"
      [[ "$i" -eq "$selected" ]] && is_sel="true"
      _menu_item "${MENU_KEYS[$i]}" "${MENU_LABELS[$i]}" "$is_sel"
    done

    _box_blank
    echo -e "  ${CYAN}* ${CYAN}${ITALIC}╚══════════════════════════════════════════════╝${NC}${CYAN} *${NC}"
    echo ""
    echo -e "  ${CYAN}navigate${NC} j/k  ${CYAN}select${NC} Enter  ${CYAN}jump${NC} direct key"
    printf '\033[?25h'
  )
  printf '%s' "$buf"
}

# ─── Action dispatcher ───────────────────────────────────────────────────────
execute_action() {
  # Drain any buffered stdin — prevents a trailing Enter (typed after the
  # jump key) from instantly consuming "Press Enter to continue..." prompts
  while IFS= read -r -n 1 -s -t 0.001 2>/dev/null; do :; done

  local choice="$1"
  case "$choice" in
    q)
      do_quick
      read -r -p "Press Enter to continue..." || true
      ;;
    u) do_update ;;
    a) do_aur_update ;;
    p) do_appimage_update ;;
    n) do_install_appimage_tool ;;
    o) do_orphans ;;
    c) do_cache ;;
    d) do_db_check ;;
    f) do_foreign ;;
    i) do_info ;;
    r)
      do_update
      do_aur_update
      do_appimage_update
      do_orphans
      do_cache
      do_db_check
      do_foreign
      do_info
      read -r -p "Press Enter to continue..." || true
      ;;
    0)
      echo -e "\n${PINK}*${NC} ${GREEN}Goodbye!${NC} ${PINK}*${NC}\n"
      exit 0
      ;;
    *)
      print_error "Invalid option"
      sleep 1
      ;;
  esac
}

main() {
  check_sudo

  if [ "${1:-}" == "--quick" ]; then
    do_quick
    exit 0
  fi

  local selected=0
  local num_items=${#MENU_KEYS[@]}

  while true; do
    show_menu "$selected"

    IFS= read -rsn1 key

    if [[ "$key" == $'\x1b' ]]; then
      read -rsn2 -t 0.1 2>/dev/null || true
      continue
    fi

    case "$key" in
      j) selected=$(( (selected + 1) % num_items )) ;;
      k) selected=$(( (selected - 1 + num_items) % num_items )) ;;
      '')
        execute_action "${MENU_KEYS[$selected]}"
        _MENU_INITIALIZED=false
        ;;
      *)
        local found=false
        local idx
        for idx in "${!MENU_KEYS[@]}"; do
          if [[ "${MENU_KEYS[$idx]}" == "$key" ]]; then
            selected=$idx
            execute_action "$key"
            _MENU_INITIALIZED=false
            found=true
            break
          fi
        done
        if [[ "$found" == "false" ]]; then
          print_error "Invalid option"
          sleep 1
          _MENU_INITIALIZED=false
        fi
        ;;
    esac
  done
}

main "$@"