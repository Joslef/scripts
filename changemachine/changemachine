CONF="$HOME/.config/hypr/hyprland.lua"
SUNSHINE_CONF="$HOME/.config/sunshine/sunshine.conf"
IPAD_RESOLUTION="2732x2048@60"
IPAD_POSITION="7680x0"

# ─── Helper functions ─────────────────────────────────────────────────────────
