# ─── Detect current machine profile ──────────────────────────────────────────
detect_machine() {
  # Match lines whose first non-whitespace char is NOT '#' (i.e. active lines)
  # ipad: any uncommented line tagged # ipad
  if grep -qP '^\s*[^#\s].*#\s*ipad\s*$' "$CONF" 2>/dev/null; then
    echo "ipad"
  # lggram: any uncommented line tagged # lggram
  elif grep -qP '^\s*[^#\s].*#\s*lggram\s*$' "$CONF" 2>/dev/null; then
    echo "lggram"
  else
    echo "gcube"
  fi
}

# ─── Toggle comments in hyprland.conf ────────────────────────────────────────
apply_profile() {
  local target="$1"
  python3 - "$CONF" "$target" <<'PYEOF'
import re, sys

conf   = sys.argv[1]
target = sys.argv[2]

if target == 'gcube':
    enable  = {'gcube'}
    disable = {'lggram', 'ipad'}
elif target == 'lggram':
    enable  = {'lggram'}
    disable = {'gcube', 'ipad'}
elif target == 'ipad':
    # ipad = gcube monitors + headless monitors on top
    enable  = {'gcube', 'ipad'}
    disable = {'lggram'}
else:
    sys.exit(f"unknown target: {target}")

with open(conf) as f:
    lines = f.readlines()

out = []
for line in lines:
    m = re.search(r'#\s*(gcube|lggram|ipad)\s*$', line)
    if m:
        tag     = m.group(1)
        raw     = line.rstrip('\n')
        nl      = '\n' if line.endswith('\n') else ''
        stripped = raw.lstrip()
        indent   = raw[:len(raw) - len(stripped)]
        is_commented = stripped.startswith('#')

        if tag in enable and is_commented:
            # Uncomment: remove the leading "# " (one level only)
            stripped = re.sub(r'^#\s?', '', stripped, count=1)
            line = indent + stripped + nl
        elif tag in disable and not is_commented:
            # Comment out
            line = indent + '# ' + stripped + nl
    out.append(line)

with open(conf, 'w') as f:
    f.writelines(out)
PYEOF
}

# ─── Restart waybar ───────────────────────────────────────────────────────────
restart_waybar() {
  pkill waybar 2>/dev/null || true
  sleep 0.4
  waybar &>/dev/null &
  disown
  print_success "waybar restarted"
}

# ─── Reload hyprland config ───────────────────────────────────────────────────
reload_hyprland() {
  hyprctl reload &>/dev/null
  print_success "hyprland config reloaded"
}

# ─── Switch to a machine profile ─────────────────────────────────────────────
do_switch() {
  local target="$1"
  local current
  current=$(detect_machine)

  if [ "$current" = "$target" ]; then
    print_warning "Already on ${BOLD}${target}${NC} — nothing to do"
    sleep 1.5
    return
  fi

  print_header "Switching  ${current}  →  ${target}"

  # 1. Edit hyprland.conf
  apply_profile "$target"
  print_success "hyprland.conf updated for ${BOLD}${target}${NC}"

  # 2. Machine-specific pre-reload steps
  if [ "$target" = "ipad" ]; then
    echo -e "${CYAN}  Creating headless output for iPad/Moonlight...${NC}"
    hyprctl output create headless &>/dev/null || true
    sleep 0.5
    print_success "headless output created"
  fi

  # 3. Remove stale headless outputs when leaving ipad mode
  if [ "$current" = "ipad" ] && [ "$target" != "ipad" ]; then
    echo -e "${CYAN}  Removing headless outputs...${NC}"
    for h in HEADLESS-1 HEADLESS-2 HEADLESS-3; do
      hyprctl output remove "$h" &>/dev/null || true
    done
    print_success "headless outputs removed"
  fi

  # 4. Reload hyprland
  sleep 0.3
  reload_hyprland

  # 5. Restart waybar (monitor layout changed)
  sleep 0.5
  restart_waybar

  echo ""
  print_success "${BOLD}${HOT_PINK}Active machine: ${target}${NC}"
  sleep 1.5
}

# ─── Menu ─────────────────────────────────────────────────────────────────────
show_menu() {
  local current
  current=$(detect_machine)

  # Label slot = exactly 9 visible chars: " ★ active" or 9 spaces.
  # Menu box interior = 60.  Machine lines: prefix(49) + label(9) + margin(2) = 60
  local label_gcube label_lggram label_ipad
  label_gcube="         "
  label_lggram="         "
  label_ipad="         "

  case "$current" in
    gcube)  label_gcube="${HOT_PINK} ★ active${NC}" ;;
    lggram) label_lggram="${HOT_PINK} ★ active${NC}" ;;
    ipad)   label_ipad="${HOT_PINK} ★ active${NC}" ;;
  esac

  clear
  print_banner
  echo -e "  ${CYAN}* ${CYAN}${ITALIC}╔════════════════════════════════════════════════════════════╗${NC}${CYAN} *"
  echo -e "    ${CYAN}${ITALIC}║${NC}                * Machine Profile Switcher *                ${CYAN}${ITALIC}║${NC}"
  echo -e "    ${CYAN}${ITALIC}╠════════════════════════════════════════════════════════════╣${NC}"
  echo -e "    ${CYAN}${ITALIC}║${NC}                                                            ${CYAN}${ITALIC}║${NC}"
  echo -e "    ${CYAN}${ITALIC}║${NC}  ${PINK}>${NC} ${GREEN}1)${NC} ${BOLD}gcube   ${NC} — Desktop  (2x 4K DP)            ${label_gcube}  ${CYAN}${ITALIC}║${NC}"
  echo -e "    ${CYAN}${ITALIC}║${NC}  ${PINK}>${NC} ${GREEN}2)${NC} ${BOLD}lggram  ${NC} — Laptop   (eDP + ext DP)        ${label_lggram}  ${CYAN}${ITALIC}║${NC}"
  echo -e "    ${CYAN}${ITALIC}║${NC}  ${PINK}>${NC} ${GREEN}3)${NC} ${BOLD}ipad    ${NC} — Desktop + iPad Moonlight       ${label_ipad}  ${CYAN}${ITALIC}║${NC}"
  echo -e "    ${CYAN}${ITALIC}║${NC}                                                            ${CYAN}${ITALIC}║${NC}"
  echo -e "    ${CYAN}${ITALIC}║${NC}  ${PINK}>${NC} ${RED}0)${NC} Exit                                                 ${CYAN}${ITALIC}║${NC}"
  echo -e "    ${CYAN}${ITALIC}║${NC}                                                            ${CYAN}${ITALIC}║${NC}"
  echo -e "  ${CYAN}* ${CYAN}${ITALIC}╚════════════════════════════════════════════════════════════╝${NC}${CYAN} *${NC}"
  echo ""
}

# ─── Entry point ──────────────────────────────────────────────────────────────
main() {
  # Optional CLI usage: changemachine gcube|lggram|ipad
  if [ "${1:-}" != "" ]; then
    case "${1}" in
      gcube|lggram|ipad) do_switch "$1"; exit 0 ;;
      *) echo -e "${RED}Usage: changemachine [gcube|lggram|ipad]${NC}"; exit 1 ;;
    esac
  fi

  while true; do
    show_menu
    read -r -p "$(echo -e "${BRIGHT_PINK}Select option [0-3]:${NC} ")" choice || true
    case $choice in
      1) do_switch "gcube"  ;;
      2) do_switch "lggram" ;;
      3) do_switch "ipad"   ;;
      0) echo -e "\n${PINK}*${NC} ${GREEN}Goodbye!${NC} ${PINK}*${NC}\n"; exit 0 ;;
      *) print_error "Invalid option"; sleep 1 ;;
    esac
  done
}

main "$@"
