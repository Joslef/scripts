#!/bin/bash

set -uo pipefail

# ─── Colors ───────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
ITALIC='\033[3m'
NC='\033[0m'

PINK='\033[38;5;198m'
BRIGHT_PINK='\033[38;5;201m'
HOT_PINK='\033[38;5;205m'

# ─── Config ───────────────────────────────────────────────────────────────────
QYLOCK_DIR="${QYLOCK_DIR:-$HOME/qylock}"
THEMES_DIR="$QYLOCK_DIR/themes"
LOCKSCREEN_DIR="$HOME/.local/share/quickshell-lockscreen"
QYLOCK_CONF="$HOME/.config/qylock/theme"
VIEWPORT=12

# ─── Helpers ──────────────────────────────────────────────────────────────────
print_header() {
  echo -e "\n${BLUE}=== $1 ===${NC}"
}

print_success() {
  echo -e "${GREEN}✓ $1${NC}"
}

print_warning() {
  echo -e "${YELLOW}⚠ $1${NC}"
}

print_error() {
  echo -e "${RED}✗ $1${NC}"
}

_box_blank() {
  echo -e "    ${CYAN}${ITALIC}║${NC}                                              ${CYAN}${ITALIC}║${NC}"
}

_box_rule() {
  printf "    ${CYAN}${ITALIC}║${NC}  ${CYAN}────────────────────────────────────────────${NC}${CYAN}${ITALIC}║${NC}\n"
}

_menu_section() {
  local title="$1"
  local prefix="── ${title} "
  local fill=$(( 44 - ${#prefix} ))
  [[ $fill -lt 2 ]] && fill=2
  local dashes="" i
  for ((i=0; i<fill; i++)); do dashes="${dashes}─"; done
  printf "    ${CYAN}${ITALIC}║${NC}  ${CYAN}%s%s${NC}${CYAN}${ITALIC}║${NC}\n" "$prefix" "$dashes"
}

_menu_item() {
  local key="$1"
  local label="$2"
  local is_selected="$3"
  local pad=$(( 38 - ${#key} - ${#label} ))
  [[ $pad -lt 0 ]] && pad=0

  if [[ "$is_selected" == "true" ]]; then
    printf "    ${CYAN}${ITALIC}║${NC}  ${BRIGHT_PINK}> %s -> %s${NC}%*s${CYAN}${ITALIC}║${NC}\n" \
      "$key" "$label" "$pad" ""
  elif [[ "$key" == "0" ]]; then
    printf "    ${CYAN}${ITALIC}║${NC}  ${PINK}>${NC} ${RED}%s${NC} -> %s%*s${CYAN}${ITALIC}║${NC}\n" \
      "$key" "$label" "$pad" ""
  else
    printf "    ${CYAN}${ITALIC}║${NC}  ${PINK}>${NC} ${GREEN}%s${NC} -> %s%*s${CYAN}${ITALIC}║${NC}\n" \
      "$key" "$label" "$pad" ""
  fi
}

