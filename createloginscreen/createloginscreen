# ─── Theme Picker ─────────────────────────────────────────────────────────────
_THEME_INITIALIZED=false
PICKED_THEME=""

# pick_theme <title>
# Sets PICKED_THEME on confirm, empty on cancel. Returns 0 on select, 1 on cancel.
pick_theme() {
  local title="$1"

  local themes=()
  while IFS= read -r t; do
    themes+=("$t")
  done < <(ls -1 "$THEMES_DIR" | grep -v '^paper$')

  local num_themes=${#themes[@]}
  if [[ $num_themes -eq 0 ]]; then
    print_error "No themes found in $THEMES_DIR"
    PICKED_THEME=""
    return 1
  fi

  local selected=0
  local offset=0
  _THEME_INITIALIZED=false

  while true; do
    local visible_end=$(( offset + VIEWPORT - 1 ))
    [[ $visible_end -ge $num_themes ]] && visible_end=$(( num_themes - 1 ))

    local init_seq
    if [[ "$_THEME_INITIALIZED" == "false" ]]; then
      init_seq=$'\033[2J\033[H'
      _THEME_INITIALIZED=true
    else
      init_seq=$'\033[H'
    fi

    local buf
    buf=$(
      printf '%s' "$init_seq"
      printf '\033[?25l'

      echo ""
      echo -e "  ${CYAN}* ${CYAN}${ITALIC}╔══════════════════════════════════════════════╗${NC}${CYAN} *"
      printf "    ${CYAN}${ITALIC}║${NC} ${BRIGHT_PINK}✦ %-43s${NC}${CYAN}${ITALIC}║${NC}\n" "$title"
      echo -e "    ${CYAN}${ITALIC}╠══════════════════════════════════════════════╣${NC}"
      # Top indicator — always exactly 1 line
      if [[ $offset -gt 0 ]]; then
        printf "    ${CYAN}${ITALIC}║${NC}  ${CYAN}↑ %d more above%-29s${NC}${CYAN}${ITALIC}║${NC}\n" "$offset" ""
      else
        _box_blank
      fi

      # Item slots — always exactly VIEWPORT lines
      local slot
      for (( slot=0; slot<VIEWPORT; slot++ )); do
        local idx=$(( offset + slot ))
        if [[ $idx -le $visible_end ]]; then
          local theme="${themes[$idx]}"
          local pad=$(( 42 - ${#theme} ))
          [[ $pad -lt 0 ]] && pad=0
          if [[ "$idx" -eq "$selected" ]]; then
            printf "    ${CYAN}${ITALIC}║${NC}  ${BRIGHT_PINK}▶ %s${NC}%*s${CYAN}${ITALIC}║${NC}\n" "$theme" "$pad" ""
          else
            printf "    ${CYAN}${ITALIC}║${NC}  ${PINK}·${NC} %s%*s${CYAN}${ITALIC}║${NC}\n" "$theme" "$pad" ""
          fi
        else
          _box_blank
        fi
      done

      # Bottom indicator — always exactly 1 line
      local remaining=$(( num_themes - visible_end - 1 ))
      if [[ $remaining -gt 0 ]]; then
        printf "    ${CYAN}${ITALIC}║${NC}  ${CYAN}↓ %d more below%-29s${NC}${CYAN}${ITALIC}║${NC}\n" "$remaining" ""
      else
        _box_blank
      fi

      _box_blank
      echo -e "  ${CYAN}* ${CYAN}${ITALIC}╚══════════════════════════════════════════════╝${NC}${CYAN} *${NC}"
      echo ""
      echo -e "  ${CYAN}navigate${NC} j/k  ${CYAN}select${NC} Enter  ${CYAN}cancel${NC} q"
      printf '\033[?25h'
    )
    printf '%s' "$buf"

    IFS= read -rsn1 key

    if [[ "$key" == $'\x1b' ]]; then
      read -rsn2 -t 0.1 2>/dev/null || true
      continue
    fi

    case "$key" in
      j)
        selected=$(( (selected + 1) % num_themes ))
        if [[ $selected -eq 0 ]]; then
          offset=0
        elif [[ $selected -gt $(( offset + VIEWPORT - 1 )) ]]; then
          offset=$(( selected - VIEWPORT + 1 ))
        fi
        ;;
      k)
        selected=$(( (selected - 1 + num_themes) % num_themes ))
        if [[ $selected -eq $(( num_themes - 1 )) ]]; then
          offset=$(( num_themes - VIEWPORT ))
          [[ $offset -lt 0 ]] && offset=0
        elif [[ $selected -lt $offset ]]; then
          offset=$selected
        fi
        ;;
      '')
        PICKED_THEME="${themes[$selected]}"
        _THEME_INITIALIZED=false
        return 0
        ;;
      q|Q)
        PICKED_THEME=""
        _THEME_INITIALIZED=false
        return 1
        ;;
    esac
  done
}

# ─── Sub-variant handlers ─────────────────────────────────────────────────────
handle_subvariants() {
  local theme="$1"
  local dir="$2"

  case "$theme" in
    terraria)
      print_header "Terraria — Background Mode"
      echo -e "  ${PINK}>${NC} ${GREEN}1${NC} -> Time-based (day/night transitions)"
      echo -e "  ${PINK}>${NC} ${GREEN}2${NC} -> Random (new background each time)"
      echo -e "  ${PINK}>${NC} ${GREEN}3${NC} -> Manual selection"
      read -r -p "Choice [1-3, default 2]: " sub_opt || sub_opt=""
      sub_opt="${sub_opt:-2}"
      case "$sub_opt" in
        1) sed -i "s/^background_mode=.*/background_mode=time/" "$dir/$theme/theme.conf" ;;
        3)
          echo -e "  ${PINK}>${NC} ${GREEN}1${NC} -> Forest mountains"
          echo -e "  ${PINK}>${NC} ${GREEN}2${NC} -> Tall mountains, flying islands"
          echo -e "  ${PINK}>${NC} ${GREEN}3${NC} -> Halloween lands with skull"
          echo -e "  ${PINK}>${NC} ${GREEN}4${NC} -> Midnight scary"
          echo -e "  ${PINK}>${NC} ${GREEN}5${NC} -> Icy cold mountains"
          read -r -p "Sub-theme [1-5, default 1]: " sub_choice || sub_choice=""
          sub_choice="${sub_choice:-1}"
          [[ "$sub_choice" =~ ^[1-5]$ ]] || sub_choice=1
          sed -i "s/^background_mode=.*/background_mode=static/" "$dir/$theme/theme.conf"
          sed -i "s/^background_index=.*/background_index=$sub_choice/" "$dir/$theme/theme.conf"
          ;;
        *) sed -i "s/^background_mode=.*/background_mode=random/" "$dir/$theme/theme.conf" ;;
      esac
      ;;
    Genshin)
      print_header "Genshin Impact — Background Mode"
      echo -e "  ${PINK}>${NC} ${GREEN}1${NC} -> Time-based (Dawn / Day / Dusk / Night)"
      echo -e "  ${PINK}>${NC} ${GREEN}2${NC} -> Random (new background each time)"
      echo -e "  ${PINK}>${NC} ${GREEN}3${NC} -> Manual selection"
      read -r -p "Choice [1-3, default 1]: " sub_opt || sub_opt=""
      sub_opt="${sub_opt:-1}"
      case "$sub_opt" in
        1) sed -i "s/^background_mode=.*/background_mode=time/" "$dir/$theme/theme.conf" ;;
        3)
          echo -e "  ${PINK}>${NC} ${GREEN}1${NC} -> Day (bright sky)"
          echo -e "  ${PINK}>${NC} ${GREEN}2${NC} -> Night (dark stars)"
          echo -e "  ${PINK}>${NC} ${GREEN}3${NC} -> Dawn (golden sunrise)"
          echo -e "  ${PINK}>${NC} ${GREEN}4${NC} -> Dusk (sunset orange)"
          read -r -p "Background [1-4, default 1]: " sub_choice || sub_choice=""
          sub_choice="${sub_choice:-1}"
          [[ "$sub_choice" =~ ^[1-4]$ ]] || sub_choice=1
          sed -i "s/^background_mode=.*/background_mode=static/" "$dir/$theme/theme.conf"
          sed -i "s/^background_index=.*/background_index=$sub_choice/" "$dir/$theme/theme.conf"
          ;;
        *) sed -i "s/^background_mode=.*/background_mode=random/" "$dir/$theme/theme.conf" ;;
      esac
      ;;
    clockwork)
      print_header "Clockwork — Options"
      echo -e "  ${PINK}>${NC} ${GREEN}1${NC} -> Dark Mode (default)"
      echo -e "  ${PINK}>${NC} ${GREEN}2${NC} -> Light Mode"
      read -r -p "Mode [1-2, default 1]: " mode_s || mode_s=""
      if [[ "${mode_s:-1}" == "2" ]]; then
        sed -i "s/^themeMode=.*/themeMode=light/" "$dir/$theme/theme.conf"
        print_success "Light mode set"
      else
        sed -i "s/^themeMode=.*/themeMode=dark/" "$dir/$theme/theme.conf"
        print_success "Dark mode set"
      fi
      read -r -p "Enable windup animation? [Y/n]: " wind_s || wind_s=""
      case "${wind_s:-Y}" in
        [nN]*) sed -i "s/^enableWindup=.*/enableWindup=false/" "$dir/$theme/theme.conf" ;;
        *)     sed -i "s/^enableWindup=.*/enableWindup=true/"  "$dir/$theme/theme.conf" ;;
      esac
      ;;
  esac
}

check_font() {
  local theme="$1"
  local dir="$2"
  local font_count
  font_count=$(ls -1 "$dir/$theme/font/" 2>/dev/null | grep -cE "\.(ttf|otf)$" || true)
  if [[ "${font_count:-0}" -eq 0 ]]; then
    print_warning "Font missing for '$theme' — place .ttf/.otf in $dir/$theme/font/"
    print_warning "See README for required font names."
  fi
}

# ─── Actions ──────────────────────────────────────────────────────────────────
do_bootscreen() {
  if [[ ! -d "$THEMES_DIR" ]]; then
    print_error "Themes directory not found: $THEMES_DIR"
    print_warning "Run 'Install' first, or set QYLOCK_DIR env var."
    read -r -p "Press Enter to continue..." || true
    return 0
  fi

  PICKED_THEME=""
  if ! pick_theme "Bootscreen Theme (SDDM)"; then
    return 0
  fi

  local theme="$PICKED_THEME"
  printf '\033[2J\033[H'
  handle_subvariants "$theme" "$THEMES_DIR"
  check_font "$theme" "$THEMES_DIR"

  print_header "Applying Bootscreen: $theme"

  local sys_themes="/usr/share/sddm/themes"
  local conf_dir="/etc/sddm.conf.d"
  local conf_file="$conf_dir/theme.conf"

  [[ ! -d "$sys_themes" ]] && sudo mkdir -p "$sys_themes"
  [[ ! -d "$conf_dir"   ]] && sudo mkdir -p "$conf_dir"

  echo "Copying theme..."
  sudo cp -r "$THEMES_DIR/$theme" "$sys_themes/"

  echo "Updating SDDM config..."
  if [[ ! -f "$conf_file" ]]; then
    printf '[Theme]\nCurrent=%s\n' "$theme" | sudo tee "$conf_file" > /dev/null
  elif grep -q "^Current=" "$conf_file"; then
    sudo sed -i "s/^Current=.*/Current=$theme/" "$conf_file"
  elif grep -q "^\[Theme\]" "$conf_file"; then
    sudo sed -i "/^\[Theme\]/a Current=$theme" "$conf_file"
  else
    printf '\n[Theme]\nCurrent=%s\n' "$theme" | sudo tee -a "$conf_file" > /dev/null
  fi

  print_success "Bootscreen theme '$theme' is now active!"
  read -r -p "Press Enter to continue..." || true
}

do_lockscreen() {
  if [[ ! -d "$THEMES_DIR" ]]; then
    print_error "Themes directory not found: $THEMES_DIR"
    print_warning "Run 'Install' first, or set QYLOCK_DIR env var."
    read -r -p "Press Enter to continue..." || true
    return 0
  fi

  if [[ ! -f "$LOCKSCREEN_DIR/lock.sh" ]]; then
    print_warning "Quickshell lockscreen not installed at $LOCKSCREEN_DIR"
    print_warning "Run 'Install' first to set up the lockscreen."
    read -r -p "Press Enter to continue..." || true
    return 0
  fi

  PICKED_THEME=""
  if ! pick_theme "Lockscreen Theme (Quickshell)"; then
    return 0
  fi

  local theme="$PICKED_THEME"
  printf '\033[2J\033[H'
  handle_subvariants "$theme" "$THEMES_DIR"
  check_font "$theme" "$THEMES_DIR"

  print_header "Applying Lockscreen: $theme"

  # Write config file (used by newer lock.sh versions)
  mkdir -p "$(dirname "$QYLOCK_CONF")"
  echo "$theme" > "$QYLOCK_CONF"

  # Patch the installed lock.sh directly — the installed version uses a
  # hardcoded export line rather than reading the config file
  sed -i "s|export QS_THEME=.*$|export QS_THEME=\"\${1:-$theme}\"|" "$LOCKSCREEN_DIR/lock.sh"

  print_success "Lockscreen theme '$theme' applied!"
  echo ""
  echo -e "  ${CYAN}Lock screen now with:${NC} $LOCKSCREEN_DIR/lock.sh"
  read -r -p "Press Enter to continue..." || true
}

do_install() {
  printf '\033[2J\033[H'
  print_header "Install Qylock"

  if [[ ! -d "$QYLOCK_DIR" ]]; then
    print_error "Qylock directory not found: $QYLOCK_DIR"
    print_warning "Clone the repo first:"
    echo "  git clone https://github.com/Darkkal44/qylock $QYLOCK_DIR"
    read -r -p "Press Enter to continue..." || true
    return 0
  fi

  echo -e "  ${CYAN}Repo:${NC} $QYLOCK_DIR"
  echo ""

  print_header "Installing System Dependencies"
  echo "Installing SDDM, Qt6, and GStreamer packages..."
  sudo pacman -S --needed \
    sddm qt6-declarative qt6-5compat qt6-svg \
    qt6-multimedia qt6-multimedia-ffmpeg \
    gst-plugins-base gst-plugins-good gst-plugins-bad gst-plugins-ugly \
    || print_warning "Some packages may have been skipped"

  echo ""
  print_header "SDDM (Bootscreen) Setup"
  if [[ -f "$QYLOCK_DIR/sddm.sh" ]]; then
    bash "$QYLOCK_DIR/sddm.sh"
  else
    print_error "sddm.sh not found in $QYLOCK_DIR"
  fi

  echo ""
  print_header "Quickshell (Lockscreen) Setup"
  if [[ -f "$QYLOCK_DIR/quickshell.sh" ]]; then
    bash "$QYLOCK_DIR/quickshell.sh"
  else
    print_error "quickshell.sh not found in $QYLOCK_DIR"
  fi

  echo ""
  print_success "Installation complete!"
  read -r -p "Press Enter to continue..." || true
}

# ─── Main Menu ────────────────────────────────────────────────────────────────
_MENU_INITIALIZED=false
MENU_KEYS=("b" "l" "i" "0")
MENU_LABELS=(
  "Bootscreen Theme (SDDM)"
  "Lockscreen Theme (Quickshell)"
  "Install from Repo"
  "Exit"
)

show_menu() {
  local selected="${1:-0}"

  local init_seq
  if [[ "$_MENU_INITIALIZED" == "false" ]]; then
    init_seq=$'\033[2J\033[H'
    _MENU_INITIALIZED=true
  else
    init_seq=$'\033[H'
  fi

  local buf
  buf=$(
    printf '%s' "$init_seq"
    printf '\033[?25l'
    print_banner

    echo -e "  ${CYAN}* ${CYAN}${ITALIC}╔══════════════════════════════════════════════╗${NC}${CYAN} *"
    echo -e "    ${CYAN}${ITALIC}║${NC} ${BRIGHT_PINK}* Qylock Login Screen Manager *${NC}              ${CYAN}${ITALIC}║${NC}"
    echo -e "    ${CYAN}${ITALIC}╠══════════════════════════════════════════════╣${NC}"
    _box_blank

    local i
    for i in "${!MENU_KEYS[@]}"; do
      case $i in
        0) _menu_section "Themes"; _box_blank ;;
        2) _box_blank; _menu_section "Setup"; _box_blank ;;
        3) _box_blank; _box_rule ;;
      esac

      local is_sel="false"
      [[ "$i" -eq "$selected" ]] && is_sel="true"
      _menu_item "${MENU_KEYS[$i]}" "${MENU_LABELS[$i]}" "$is_sel"
    done

    _box_blank
    echo -e "  ${CYAN}* ${CYAN}${ITALIC}╚══════════════════════════════════════════════╝${NC}${CYAN} *${NC}"
    echo ""
    echo -e "  ${CYAN}navigate${NC} j/k  ${CYAN}select${NC} Enter  ${CYAN}jump${NC} direct key"
    printf '\033[?25h'
  )
  printf '%s' "$buf"
}

execute_action() {
  local choice="$1"
  case "$choice" in
    b) do_bootscreen ;;
    l) do_lockscreen ;;
    i) do_install ;;
    0)
      echo -e "\n${PINK}*${NC} ${GREEN}Goodbye!${NC} ${PINK}*${NC}\n"
      exit 0
      ;;
    *)
      print_error "Invalid option"
      sleep 1
      ;;
  esac
}

main() {
  local selected=0
  local num_items=${#MENU_KEYS[@]}

  while true; do
    show_menu "$selected"

    IFS= read -rsn1 key

    if [[ "$key" == $'\x1b' ]]; then
      read -rsn2 -t 0.1 2>/dev/null || true
      continue
    fi

    case "$key" in
      j) selected=$(( (selected + 1) % num_items )) ;;
      k) selected=$(( (selected - 1 + num_items) % num_items )) ;;
      '')
        execute_action "${MENU_KEYS[$selected]}"
        _MENU_INITIALIZED=false
        ;;
      *)
        local found=false
        local idx
        for idx in "${!MENU_KEYS[@]}"; do
          if [[ "${MENU_KEYS[$idx]}" == "$key" ]]; then
            selected=$idx
            execute_action "$key"
            _MENU_INITIALIZED=false
            found=true
            break
          fi
        done
        if [[ "$found" == "false" ]]; then
          print_error "Invalid option"
          sleep 1
          _MENU_INITIALIZED=false
        fi
        ;;
    esac
  done
}

main "$@"
