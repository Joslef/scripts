# ─── Get current left monitor width ──────────────────────────────────────────
get_left_width() {
  hyprctl monitors -j | python3 -c "
import sys, json
monitors = json.load(sys.stdin)
m = next(m for m in monitors if m['name'] == 'DP-1')
print(int(m['width'] / m['scale']))
"
}

get_right_res() {
  hyprctl monitors -j | python3 -c "
import sys, json
monitors = json.load(sys.stdin)
m = next(m for m in monitors if m['name'] == 'HDMI-A-1')
rate = m['refreshRate']
# Round to nearest integer if within 0.1, else 2 decimal places
rate = round(rate) if abs(rate - round(rate)) < 0.1 else round(rate, 2)
print(f\"{m['width']}x{m['height']}@{rate}\")
"
}

# ─── Restart waybar so it reflows to new monitor dimensions ──────────────────
restart_waybar() {
  pkill waybar 2>/dev/null || true
  sleep 0.5
  waybar &>/dev/null &
  disown
}

# ─── Apply resolution to a single monitor ────────────────────────────────────
apply_monitor() {
  local name="$1"
  local res="$2"
  local rate="$3"
  local posx="$4"
  local posy="$5"
  hyprctl keyword monitor "${name},${res}@${rate},${posx}x${posy},1"
}

# ─── Display picker sub-menu ─────────────────────────────────────────────────
SELECTED_DISPLAY=""

show_display_menu() {
  local res_name="$1"
  while true; do
    clear
    print_banner
    echo -e "  ${CYAN}* ${CYAN}${ITALIC}╔══════════════════════════════════════╗${NC}${CYAN} *"
    echo -e "    ${CYAN}${ITALIC}║${NC} ${BRIGHT_PINK}* Apply ${res_name} to... *${NC}              ${CYAN}${ITALIC}║${NC}"
    echo -e "    ${CYAN}${ITALIC}╠══════════════════════════════════════╣${NC}"
    echo -e "    ${CYAN}${ITALIC}║${NC}                                      ${CYAN}${ITALIC}║${NC}"
    echo -e "    ${CYAN}${ITALIC}║${NC}  ${PINK}>${NC} ${GREEN}1)${NC} Display Left (DP-1)            ${CYAN}${ITALIC}║${NC}"
    echo -e "    ${CYAN}${ITALIC}║${NC}  ${PINK}>${NC} ${GREEN}2)${NC} Display Right (HDMI-A-1)       ${CYAN}${ITALIC}║${NC}"
    echo -e "    ${CYAN}${ITALIC}║${NC}  ${PINK}>${NC} ${GREEN}3)${NC} Both                           ${CYAN}${ITALIC}║${NC}"
    echo -e "    ${CYAN}${ITALIC}║${NC}                                      ${CYAN}${ITALIC}║${NC}"
    echo -e "    ${CYAN}${ITALIC}║${NC}  ${PINK}>${NC} ${RED}0)${NC} Back                           ${CYAN}${ITALIC}║${NC}"
    echo -e "    ${CYAN}${ITALIC}║${NC}                                      ${CYAN}${ITALIC}║${NC}"
    echo -e "  ${CYAN}* ${CYAN}${ITALIC}╚══════════════════════════════════════╝${NC}${CYAN} *${NC}"
    echo ""
    read -r -p "$(echo -e "${BRIGHT_PINK}Select option [0-3]:${NC} ")" display_choice || true
    case $display_choice in
      1) SELECTED_DISPLAY="left";  return ;;
      2) SELECTED_DISPLAY="right"; return ;;
      3) SELECTED_DISPLAY="both";  return ;;
      0) SELECTED_DISPLAY="back";  return ;;
      *) print_error "Invalid option"; sleep 1 ;;
    esac
  done
}

# ─── Resolution logic ─────────────────────────────────────────────────────────
do_resolution() {
  local res_name="$1"
  local res="$2"
  local base_rate="$3"

  show_display_menu "$res_name"

  case $SELECTED_DISPLAY in
    back) return ;;

    left)
      # DP-1 rate adjustments
      local rate="$base_rate"
      if [ "$res_name" = "Steamdeck" ]; then rate="59.81"
      elif [ "$res_name" = "2K" ];       then rate="59.95"
      fi
      local new_left_width right_res
      new_left_width="${res%%x*}"
      right_res=$(get_right_res)
      hyprctl --batch "keyword monitor DP-1,${res}@${rate},0x0,1 ; keyword monitor HDMI-A-1,${right_res},${new_left_width}x0,1"
      restart_waybar
      print_success "Applied ${res_name} to Display Left (DP-1)"
      sleep 1
      ;;

    right)
      # HDMI-A-1 rate adjustments
      local rate="$base_rate"
      if [ "$res_name" = "Steamdeck" ]; then rate="59.91"
      elif [ "$res_name" = "2K" ];       then rate="59.95"
      fi
      local left_width
      left_width=$(get_left_width)
      apply_monitor "HDMI-A-1" "$res" "$rate" "$left_width" "0"
      restart_waybar
      print_success "Applied ${res_name} to Display Right (HDMI-A-1)"
      sleep 1
      ;;

    both)
      local left_rate="$base_rate"
      if [ "$res_name" = "Steamdeck" ]; then left_rate="59.81"
      elif [ "$res_name" = "2K" ];       then left_rate="59.95"
      fi
      local right_rate="$base_rate"
      if [ "$res_name" = "Steamdeck" ]; then right_rate="59.91"
      elif [ "$res_name" = "2K" ];       then right_rate="59.95"
      fi
      local new_left_width="${res%%x*}"
      hyprctl --batch "keyword monitor DP-1,${res}@${left_rate},0x0,1 ; keyword monitor HDMI-A-1,${res}@${right_rate},${new_left_width}x0,1"
      restart_waybar
      print_success "Applied ${res_name} to both displays"
      sleep 1
      ;;
  esac
}

# ─── Reset ────────────────────────────────────────────────────────────────────
do_reset() {
  hyprctl --batch "keyword monitor DP-1,3840x2160@60,0x0,1 ; keyword monitor HDMI-A-1,3840x2160@60,3840x0,1"
  restart_waybar
  print_success "Reset both displays to 4K (3840x2160@60)"
  sleep 1
}

