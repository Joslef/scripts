#!/bin/bash

set -uo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'
print_header() { echo -e "\n${BLUE}=== $1 ===${NC}"; }
print_success() { echo -e "${GREEN}✓ $1${NC}"; }
print_warning() { echo -e "${YELLOW}⚠ $1${NC}"; }
print_error() { echo -e "${RED}✗ $1${NC}"; }

usage() {
  echo -e "Usage: ${BOLD}photoimport${NC} [SOURCE] [DEST] [--dry-run] [--run] [--fix-rotation]"
  echo ""
  echo -e "  SOURCE          Folder with photos to import (default: /mnt/vault/Bilder/fotoimport)"
  echo -e "  DEST            Root photo library folder    (default: /mnt/vault/Bilder/Fotos)"
  echo ""
  echo -e "  ${CYAN}--dry-run${NC}       Preview what would be copied/fixed — no files are written"
  echo -e "  ${CYAN}--run${NC}           Skip confirmation prompt and run immediately"
  echo -e "  ${CYAN}--fix-rotation${NC}  Scan a library path and fix Live Photo MOV orientations"
  echo -e "  ${CYAN}--help${NC}          Show this help"
  echo ""
  echo -e "Files are placed into DEST/yyyy/mm/dd/ based on EXIF date."
  echo -e "Date priority: DateTimeOriginal → CreateDate → FileModifyDate"
  echo ""
  echo -e "Standalone rotation fix (no import):"
  echo -e "  ${CYAN}photoimport --fix-rotation [PATH]${NC}   PATH defaults to DEST if omitted"
  echo -e "  ${CYAN}photoimport --fix-rotation /mnt/vault/Bilder/Fotos/2026${NC}"
}

check_deps() {
  local missing=0
  if ! command -v exiftool &>/dev/null; then
    print_error "exiftool not found — install: sudo pacman -S perl-image-exiftool"
    missing=1
  fi
  if ! command -v python3 &>/dev/null; then
    print_error "python3 not found"
    missing=1
  fi
  if ! command -v magick &>/dev/null; then
    print_error "magick not found — install: sudo pacman -S imagemagick"
    missing=1
  fi
  if ! command -v ffmpeg &>/dev/null; then
    print_error "ffmpeg not found — install: sudo pacman -S ffmpeg"
    missing=1
  fi
  [[ $missing -eq 0 ]] || exit 1
}

# ── Defaults ──────────────────────────────────────────────────────────────────
SRC="/mnt/vault/Bilder/fotoimport"
DST="/mnt/vault/Bilder/Fotos"
DRY_RUN=0
AUTO_RUN=0
FIX_ROTATION=0

# ── Argument parsing ──────────────────────────────────────────────────────────
POSITIONAL=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run|-n)      DRY_RUN=1; shift ;;
    --run|-y)          AUTO_RUN=1; shift ;;
    --fix-rotation|-f) FIX_ROTATION=1; shift ;;
    --help|-h)         usage; exit 0 ;;
    -*)                print_error "Unknown flag: $1"; echo ""; usage; exit 1 ;;
    *)                 POSITIONAL+=("$1"); shift ;;
  esac
done

# Positional arg semantics differ by mode:
#   import mode (--run or no --fix-rotation): [SOURCE] [DEST]
#   fix-rotation standalone:                  [SCAN_PATH]
SCAN_PATH="$DST"
if [[ $FIX_ROTATION -eq 1 && $AUTO_RUN -eq 0 ]]; then
  [[ ${#POSITIONAL[@]} -ge 1 ]] && SCAN_PATH="${POSITIONAL[0]}"
else
  [[ ${#POSITIONAL[@]} -ge 1 ]] && SRC="${POSITIONAL[0]}"
  [[ ${#POSITIONAL[@]} -ge 2 ]] && DST="${POSITIONAL[1]}" && SCAN_PATH="$DST"
fi

# ── Validate ──────────────────────────────────────────────────────────────────
check_deps

DO_IMPORT=0

if [[ $AUTO_RUN -eq 1 || $FIX_ROTATION -eq 0 ]]; then
  # Import mode
  if [[ ! -d "$SRC" ]]; then
    print_error "Source folder not found: $SRC"; exit 1
  fi
  if [[ ! -d "$DST" ]]; then
    print_error "Destination folder not found: $DST"; exit 1
  fi
  FILE_COUNT=$(find "$SRC" -type f | wc -l)
  if [[ $FILE_COUNT -eq 0 ]]; then
    print_warning "No files found in $SRC — nothing to do."
    [[ $FIX_ROTATION -eq 0 ]] && exit 0
  else
    DO_IMPORT=1
  fi
else
  # --fix-rotation standalone
  if [[ ! -d "$SCAN_PATH" ]]; then
    print_error "Scan path not found: $SCAN_PATH"; exit 1
  fi
fi

# ── Import plan summary ───────────────────────────────────────────────────────
if [[ $DO_IMPORT -eq 1 ]]; then
  print_header "Import Plan"
  echo -e "  ${CYAN}Source:${NC}      $SRC"
  echo -e "  ${CYAN}Destination:${NC} $DST"
  echo -e "  ${CYAN}Files:${NC}       $FILE_COUNT file(s)"
  [[ $DRY_RUN -eq 1 ]] && echo -e "\n  ${YELLOW}⚠ DRY RUN — no files will be written${NC}"
  if [[ $AUTO_RUN -eq 0 ]]; then
    echo ""
    read -r -p "Proceed? [Y/n]: " response
    case "$response" in
      [nN][oO]|[nN]) echo -e "${YELLOW}⚠ Aborted${NC}"; exit 0 ;;
    esac
  fi
fi

# ── Fix-rotation plan summary (standalone) ────────────────────────────────────
if [[ $FIX_ROTATION -eq 1 && $DO_IMPORT -eq 0 ]]; then
  print_header "Rotation Fix Plan"
  echo -e "  ${CYAN}Scan path:${NC}  $SCAN_PATH"
  [[ $DRY_RUN -eq 1 ]] && echo -e "\n  ${YELLOW}⚠ DRY RUN — no files will be written${NC}"
  if [[ $AUTO_RUN -eq 0 ]]; then
    echo ""
    read -r -p "Proceed? [Y/n]: " response
    case "$response" in
      [nN][oO]|[nN]) echo -e "${YELLOW}⚠ Aborted${NC}"; exit 0 ;;
    esac
  fi
fi

# ── Python ────────────────────────────────────────────────────────────────────
PHOTO_SRC="$SRC" \
PHOTO_DST="$DST" \
PHOTO_SCAN_PATH="$SCAN_PATH" \
PHOTO_DRY_RUN="$DRY_RUN" \
PHOTO_DO_IMPORT="$DO_IMPORT" \
PHOTO_FIX_ROTATION="$FIX_ROTATION" \
PHOTO_GREEN="$GREEN" \
PHOTO_YELLOW="$YELLOW" \
PHOTO_RED="$RED" \
PHOTO_NC="$NC" \
python3 << 'PYEOF'
import csv, collections, hashlib, os, shutil, subprocess, sys, tempfile

src          = os.environ["PHOTO_SRC"]
dst          = os.environ["PHOTO_DST"]
scan_path    = os.environ["PHOTO_SCAN_PATH"]
dry_run      = os.environ["PHOTO_DRY_RUN"] == "1"
do_import    = os.environ["PHOTO_DO_IMPORT"] == "1"
fix_rotation = os.environ["PHOTO_FIX_ROTATION"] == "1"
G            = os.environ["PHOTO_GREEN"]
Y            = os.environ["PHOTO_YELLOW"]
R            = os.environ["PHOTO_RED"]
NC           = os.environ["PHOTO_NC"]

def parse_qt_rotation(text):
    text = (text or "").strip()
    if not text or "normal" in text.lower():
        return 0
    for deg in (270, 180, 90):
        if str(deg) in text:
            return deg
    try:
        return int(text)
    except ValueError:
        return None

def best_date(row):
    for field in ["DateTimeOriginal", "CreateDate", "FileModifyDate"]:
        val = row.get(field, "").strip()
        if val and not val.startswith("0000"):
            return val
    return None

def file_hash(path):
    h = hashlib.md5()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()

def dir_hashes(dirpath):
    hashes = set()
    if os.path.isdir(dirpath):
        for fname in os.listdir(dirpath):
            fpath = os.path.join(dirpath, fname)
            if os.path.isfile(fpath):
                hashes.add(file_hash(fpath))
    return hashes

def fix_heic_mirroring(heic_paths, dry_run):
    """Re-encode HEICs with mirror orientations using the correct per-orientation pixel transform.

    magick -auto-orient is a no-op on HEIC files — it re-encodes but never applies the transform
    to pixels. Explicit geometric ops must be used instead:
      Orientation 2 (mirror H)     → -flop
      Orientation 4 (mirror V)     → -flip
      Orientation 5 (mirror H+270) → -transpose
      Orientation 7 (mirror H+90)  → -transverse
    Returns count of files fixed.
    """
    ORIENT_OP   = {2: "-flop", 4: "-flip", 5: "-transpose", 7: "-transverse"}
    ORIENT_DESC = {2: "mirror H", 4: "mirror V", 5: "mirror H+270°", 7: "mirror H+90°"}

    file_meta = {}
    CHUNK = 200
    for i in range(0, len(heic_paths), CHUNK):
        batch = heic_paths[i:i+CHUNK]
        r = subprocess.run(
            ["exiftool", "-csv", "-Orientation#"] + batch,
            capture_output=True, text=True
        )
        for row in csv.DictReader(r.stdout.splitlines()):
            file_meta[row["SourceFile"]] = row

    fixed = 0
    for path in heic_paths:
        try:
            orient = int(file_meta.get(path, {}).get("Orientation#", "").strip())
        except (ValueError, AttributeError):
            continue

        op = ORIENT_OP.get(orient)
        if not op:
            continue

        action = "Would fix" if dry_run else "Fixed"
        orient_desc = ORIENT_DESC.get(orient, f"orient {orient}")
        print(f"  {G}⟳{NC} {action} HEIC orientation: {os.path.basename(path)}  ({orient_desc} → normal)")

        if dry_run:
            fixed += 1
            continue

        dirpath = os.path.dirname(path)
        fd, tmp = tempfile.mkstemp(suffix='.heic', dir=dirpath)
        os.close(fd)
        result = subprocess.run(
            ["magick", path, op, tmp],
            capture_output=True
        )
        if result.returncode == 0:
            os.replace(tmp, path)
            fixed += 1
        else:
            os.unlink(tmp)
            print(f"  {R}✗{NC} magick failed for {os.path.basename(path)}")

    return fixed


def run_rotation_fix(scan_root, label_suffix=""):
    """Scan scan_root for HEIC+MOV pairs and fix wrong MOV rotations."""
    candidates = []
    for root, dirs, files in os.walk(scan_root):
        dirs.sort()
        by_lower = {f.lower(): f for f in files}
        for f in sorted(files):
            if not f.lower().endswith('.heic'):
                continue
            stem = os.path.splitext(f)[0]
            mov_key = stem.lower() + '.mov'
            if mov_key in by_lower:
                candidates.append((
                    os.path.join(root, f),
                    os.path.join(root, by_lower[mov_key]),
                ))

    print(f"  found {len(candidates)} HEIC+MOV pairs, reading metadata …")

    if not candidates:
        return 0, 0

    file_meta = {}
    CHUNK = 100
    all_files = [p for pair in candidates for p in pair]
    for i in range(0, len(all_files), CHUNK * 2):
        batch = all_files[i : i + CHUNK * 2]
        r = subprocess.run(
            ["exiftool", "-csv", "-Orientation#", "-ImageWidth", "-ImageHeight",
             "-VideoFrameRate", "-Rotation"] + batch,
            capture_output=True, text=True
        )
        for row in csv.DictReader(r.stdout.splitlines()):
            file_meta[row["SourceFile"]] = row

    fixed = 0
    already_correct = 0
    for heic_path, mov_path in candidates:
        heic_meta = file_meta.get(heic_path, {})
        mov_meta  = file_meta.get(mov_path, {})

        if not mov_meta.get("VideoFrameRate", "").strip():
            continue

        try:
            heic_orient = int(heic_meta.get("Orientation#", "1").strip() or "1")
        except (ValueError, AttributeError):
            heic_orient = 1

        qt_rotation = parse_qt_rotation(heic_meta.get("Rotation", ""))

        if heic_orient in (5, 7):
            # Selfie mirror orientations: MOV has diagonal flip matrix — fixed at import via ffmpeg
            already_correct += 1
            continue
        elif qt_rotation == 0:
            try:
                w = int(heic_meta.get("ImageWidth", "0").strip())
                h = int(heic_meta.get("ImageHeight", "0").strip())
            except (ValueError, AttributeError):
                continue
            desired = 90 if h > w else 0
        else:
            desired = qt_rotation

        try:
            current = int(mov_meta.get("Rotation", "").strip())
        except (ValueError, AttributeError):
            current = None

        if current == desired:
            already_correct += 1
            continue

        if not dry_run:
            subprocess.run(
                ["exiftool", "-overwrite_original", f"-Rotation={desired}", mov_path],
                capture_output=True
            )

        fixed += 1
        action = "Would fix" if dry_run else "Fixed"
        print(f"  {G}↻{NC} {action} rotation{label_suffix}: {os.path.basename(mov_path)}"
              f"  (→ {desired}°)")

    return fixed, already_correct


# ── Import ────────────────────────────────────────────────────────────────────
if do_import:
    print(f"\n\033[0;34m=== Processing ===\033[0m")

    # Single exiftool pass: dates + orientation metadata for all source files
    result = subprocess.run(
        ["exiftool", "-csv", "-r", "-d", "%Y/%m/%d",
         "-DateTimeOriginal", "-CreateDate", "-FileModifyDate",
         "-Orientation#", "-ImageWidth", "-ImageHeight",
         "-VideoFrameRate", "-Rotation", src],
        capture_output=True, text=True
    )
    rows = {row["SourceFile"]: row for row in csv.DictReader(result.stdout.splitlines())}

    files = sorted(
        os.path.join(root, f)
        for root, _, fnames in os.walk(src)
        for f in fnames
    )

    # Phase 1: fix orientations in source (fotoimport) BEFORE copying to library
    print("")
    src_by_stem = collections.defaultdict(dict)
    for filepath in files:
        stem, ext = os.path.splitext(os.path.basename(filepath))
        src_by_stem[(os.path.dirname(filepath), stem)][ext.lower()] = filepath

    import_fixed_mov = 0
    ffmpeg_movs_src  = []

    for (d, stem), exts in sorted(src_by_stem.items()):
        heic = exts.get(".heic")
        mov  = exts.get(".mov")
        if not (heic and mov):
            continue
        heic_meta = rows.get(heic, {})
        mov_meta  = rows.get(mov, {})
        if not mov_meta.get("VideoFrameRate", "").strip():
            continue
        try:
            heic_orient = int(heic_meta.get("Orientation#", "1").strip() or "1")
        except (ValueError, AttributeError):
            heic_orient = 1
        qt_rotation = parse_qt_rotation(heic_meta.get("Rotation", ""))

        if heic_orient in (5, 7):
            # Selfie: MOV has diagonal flip matrix — needs ffmpeg pixel rewrite
            ffmpeg_movs_src.append(mov)
            continue
        elif qt_rotation == 0:
            try:
                w = int(heic_meta.get("ImageWidth", "0").strip())
                h = int(heic_meta.get("ImageHeight", "0").strip())
            except (ValueError, AttributeError):
                continue
            desired = 90 if h > w else 0
        else:
            desired = qt_rotation
            if desired is None:
                continue

        try:
            current = int(mov_meta.get("Rotation", "").strip())
        except (ValueError, AttributeError):
            current = None
        if current == desired:
            continue

        if not dry_run:
            subprocess.run(
                ["exiftool", "-overwrite_original", f"-Rotation={desired}", mov],
                capture_output=True
            )
        import_fixed_mov += 1
        action = "Would fix" if dry_run else "Fixed"
        print(f"  {G}↻{NC} {action} rotation: {os.path.basename(mov)}  ({desired}°)")

    # ffmpeg fix for selfie Live Photo MOVs in source
    selfie_fixed = 0
    for mov_path in ffmpeg_movs_src:
        action = "Would fix" if dry_run else "Fixed"
        print(f"  {G}⟳{NC} {action} selfie MOV: {os.path.basename(mov_path)}")
        if dry_run:
            selfie_fixed += 1
            continue
        fd, tmp = tempfile.mkstemp(suffix='.mov', dir='/tmp')
        os.close(fd)
        result = subprocess.run(
            ["ffmpeg", "-noautorotate", "-i", mov_path, "-vf", "transpose=0",
             "-c:v", "libx265", "-crf", "18", "-c:a", "copy", "-y", tmp],
            capture_output=True
        )
        if result.returncode == 0:
            shutil.move(tmp, mov_path)  # shutil.move handles cross-device (tmpfs → NAS)
            selfie_fixed += 1
        else:
            try: os.unlink(tmp)
            except FileNotFoundError: pass
            print(f"  {R}✗{NC} ffmpeg failed for {os.path.basename(mov_path)}")

    # Fix HEIC mirror orientations in source
    src_heics = [f for f in files if f.lower().endswith('.heic')]
    heic_orient_fixed = fix_heic_mirroring(src_heics, dry_run)

    # Phase 2: copy already-fixed files to destination
    print("")
    copied     = 0
    duplicates = 0
    no_date    = []

    for filepath in files:
        fname = os.path.basename(filepath)
        date = best_date(rows.get(filepath, {}))
        if not date:
            no_date.append(fname)
            print(f"  {Y}⚠ no date:{NC} {fname}")
            continue
        dest_dir  = os.path.join(dst, date)
        dest_file = os.path.join(dest_dir, fname)
        if os.path.exists(dest_file):
            duplicates += 1
            print(f"  {Y}⊘ duplicate:{NC} {fname}  (already in {date}/)")
            continue
        incoming_hash = file_hash(filepath)
        if incoming_hash in dir_hashes(dest_dir):
            duplicates += 1
            print(f"  {Y}⊘ duplicate:{NC} {fname}  (same content already in {date}/)")
            continue
        if not dry_run:
            os.makedirs(dest_dir, exist_ok=True)
            shutil.copy2(filepath, dest_file)
        copied += 1
        action = "Would copy" if dry_run else "Copied"
        print(f"  {G}✓{NC} {action}: {fname}  →  {date}/")

    label = "Would copy" if dry_run else "Copied"
    print(f"\n{'─'*54}")
    print(f"  {G}✓ {label}:{NC}          {copied}")
    print(f"  {Y}⊘ Duplicates not imported:{NC} {duplicates}")
    if import_fixed_mov:
        print(f"  {G}↻ Live Photo rotation fixed:{NC} {import_fixed_mov}")
    if selfie_fixed:
        print(f"  {G}⟳ Selfie MOV fixed (ffmpeg):{NC} {selfie_fixed}")
    if heic_orient_fixed:
        print(f"  {G}⟳ HEIC orientation fixed:{NC}   {heic_orient_fixed}")
    if no_date:
        print(f"  {Y}⚠ No date found (skipped):{NC} {len(no_date)}")
        for f in no_date:
            print(f"      · {f}")
    if dry_run:
        print(f"\n  {Y}⚠ Dry run complete — rerun without --dry-run to copy files{NC}")
    print(f"{'─'*54}")


# ── Full-library / targeted rotation fix ─────────────────────────────────────
if fix_rotation:
    print(f"\n\033[0;34m=== Scanning for Rotation Issues ===\033[0m")
    print(f"  {Y}scanning {scan_path} …{NC}\n")

    mov_fixed, already_correct = run_rotation_fix(scan_path)

    all_heics = [
        os.path.join(root, f)
        for root, _, files in os.walk(scan_path)
        for f in sorted(files)
        if f.lower().endswith('.heic')
    ]
    print(f"\n  checking {len(all_heics)} HEIC files for mirror orientation …")
    heic_fixed = fix_heic_mirroring(all_heics, dry_run)

    print(f"\n{'─'*54}")
    if mov_fixed:
        print(f"  {G}↻ MOV rotation fixed:{NC}     {mov_fixed}")
    else:
        print(f"  {G}✓ No MOV rotation issues{NC}")
    if heic_fixed:
        print(f"  {G}⟳ HEIC orientation fixed:{NC} {heic_fixed}")
    else:
        print(f"  {G}✓ No HEIC orientation issues{NC}")
    if already_correct:
        print(f"  {G}✓ MOV already correct:{NC}    {already_correct}")
    if dry_run:
        print(f"\n  {Y}⚠ Dry run — rerun without --dry-run to apply fixes{NC}")
    print(f"{'─'*54}")

PYEOF
